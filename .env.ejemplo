# Entorno del IDE ESP32 (monorepo)
DEBUG=True
LOG_LEVEL=INFO

# Core API
API_HOST=127.0.0.1
API_PORT=8765

# Toolchain Nativo Principal: Espressif ESP-IDF / EIM
# Si no se especifican, el IDE autodetecta instalaciones en C:\Espressif, C:\espp y E:\DATOS\PROGRAMAS\esp\.espressif
# ESPRESSIF_PATH=E:\DATOS\PROGRAMAS\esp\.espressif
# IDF_PATH=E:\DATOS\PROGRAMAS\esp\.espressif\v6.1.1\esp-idf

# Herramientas Serie
PUERTO_DEFECTO=COM3
VELOCIDAD_DEFECTO=115200
TIMEOUT_PUERTO=5
